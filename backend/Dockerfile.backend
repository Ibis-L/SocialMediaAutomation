# syntax=docker/dockerfile:1
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Dependencies pehle: code badalne par ye layers rebuild nahi hoti
COPY backend/requirements.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --default-timeout=100 --retries 10 -r requirements.txt

# playwright crawl4ai ke saath already aa jata hai, bas browser download karna hai
RUN python -m playwright install --with-deps chromium

COPY backend/ /app/

WORKDIR /app/dashboard
RUN python manage.py collectstatic --noinput

EXPOSE 8000

CMD ["sh", "-c", "python manage.py migrate --noinput && gunicorn dashboard.wsgi:application --bind 0.0.0.0:8000 --workers 3 --timeout 120"]